@model Trip
@{
    ViewData["Title"] = "Trip Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalSpent = Model.TotalSpent;
    var remainingBudget = Model.BudgetLimit - totalSpent;
    var budgetPercent = Model.BudgetLimit > 0 ? Math.Min(100m, totalSpent / Model.BudgetLimit * 100m) : 0m;
    var perPersonBudget = Model.NumberOfTravelers > 0 ? Model.BudgetLimit / Model.NumberOfTravelers : 0m;
}

<div class="container-fluid">
    <!-- Trip Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-lg trip-details-hero" style="position: relative; overflow: hidden; min-height: 300px;">
                @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                {
                    <img src="@Model.CoverImageUrl" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.3;">
                }
                <div class="card-body position-relative z-2 p-5">
                    <h1 class="display-4 fw-bold mb-2">@Model.Title</h1>
                    <p class="fs-5 mb-3">
                        <i class="fas fa-map-marker-alt me-2"></i>@Model.Destination?.Name, @Model.Destination?.Country
                    </p>
                    <div class="d-flex gap-3">
                        <span class="badge bg-light text-dark px-3 py-2">
                            <i class="fas fa-calendar-alt me-2"></i>@Model.StartDate.ToString("MMM dd") - @Model.EndDate.ToString("MMM dd, yyyy")
                        </span>
                        <span class="badge bg-light text-dark px-3 py-2">
                            <i class="fas fa-users me-2"></i>@Model.NumberOfTravelers Travelers
                        </span>
                        <span class="badge bg-light text-dark px-3 py-2">
                            <i class="fas fa-tag me-2"></i>@Model.TripType
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Trip Content -->
    <div class="row">
        <div class="col-lg-8">
            <!-- Trip Information -->
            <div class="card border-0 shadow-sm mb-4 trip-detail-card">
                <div class="card-header trip-detail-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Trip Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Status:</strong><br>
                            @if (Model.Status == "Planned")
                            {
                                <span class="badge bg-warning">Planned</span>
                            }
                            else if (Model.Status == "Ongoing")
                            {
                                <span class="badge bg-success">Ongoing</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Completed</span>
                            }
                        </div>
                        <div class="col-md-6">
                            <strong>Budget Limit:</strong><br>
                            <span class="trip-money">BDT @Model.BudgetLimit.ToString("N2")</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <strong>Total Spent:</strong><br>
                            <span class="trip-money">BDT @totalSpent.ToString("N2")</span>
                        </div>
                        <div class="col-md-6">
                            <strong>Remaining Budget:</strong><br>
                            <span class="trip-money">BDT @remainingBudget.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4 trip-detail-card">
                <div class="card-header trip-detail-header trip-detail-header-coral">
                    <h5 class="mb-0"><i class="fas fa-receipt me-2"></i>Recent Expenses</h5>
                </div>
                <div class="card-body">
                    @if (Model.Expenses?.Count > 0)
                    {
                        foreach (var expense in Model.Expenses.Take(5))
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                                <div>
                                    <strong>@(expense.Description ?? "Expense")</strong>
                                    <small class="text-muted d-block">@expense.ExpenseDate.ToString("MMM dd, yyyy")</small>
                                </div>
                                <span class="trip-money">BDT @expense.Amount.ToString("N2")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">No expenses added yet. Use Quick Actions to add one.</p>
                    }
                </div>
            </div>

            <!-- Description -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header trip-detail-header trip-detail-header-green">
                        <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>Description</h5>
                    </div>
                    <div class="card-body">
                        <p>@Model.Description</p>
                    </div>
                </div>
            }

            <!-- Budget Progress -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header trip-detail-header trip-detail-header-gold">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Budget Progress</h5>
                </div>
                <div class="card-body">
                    <div class="progress" style="height: 30px;">
                        <div class="progress-bar" role="progressbar" style="width: @budgetPercent.ToString("F0")%">
                            @budgetPercent.ToString("F0")%
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2">
                        Spent: BDT @totalSpent.ToString("N2") / Budget: BDT @Model.BudgetLimit.ToString("N2")
                    </small>
                </div>
            </div>

            <!-- Itineraries -->
            @if (Model.Itineraries?.Count > 0)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-calendar-day me-2"></i>Itinerary (@Model.Itineraries.Count Days)</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var itinerary in Model.Itineraries.OrderBy(i => i.DayNumber))
                        {
                            <div class="mb-3 p-3 bg-light rounded">
                                <strong>Day @itinerary.DayNumber - @itinerary.Date.ToString("MMM dd, yyyy")</strong>
                                <p class="mb-0">@itinerary.Title</p>
                                @if (!string.IsNullOrEmpty(itinerary.Notes))
                                {
                                    <small class="text-muted">@itinerary.Notes</small>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Quick Actions</h5>
                    <div class="d-grid gap-2">
                        <a href="/trip/edit/@Model.Id" class="btn btn-outline-primary">
                            <i class="fas fa-edit me-2"></i>Edit Trip
                        </a>
                        <a href="#" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                            <i class="fas fa-plus me-2"></i>Add Expense
                        </a>
                        <a href="#" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#addAccommodationModal">
                            <i class="fas fa-hotel me-2"></i>Add Accommodation
                        </a>
                        <button type="button" class="btn btn-outline-danger" onclick="if(confirm('Delete this trip?')) location.href='/trip?handler=delete&id=@Model.Id'">
                            <i class="fas fa-trash me-2"></i>Delete Trip
                        </button>
                    </div>
                </div>
            </div>

            <!-- Trip Stats -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-bar-chart me-2"></i>Trip Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Duration:</strong><br>
                        <span class="text-muted">@((Model.EndDate - Model.StartDate).Days + 1) days</span>
                    </div>
                    <div class="mb-3">
                        <strong>Travelers:</strong><br>
                        <span class="text-muted">@Model.NumberOfTravelers people</span>
                    </div>
                    <div class="mb-3">
                        <strong>Per Person (Budget):</strong><br>
                        <span class="text-muted">BDT @perPersonBudget.ToString("N2")</span>
                    </div>
                    <div>
                        <strong>Budget Status:</strong><br>
                        @if (Model.TotalSpent > Model.BudgetLimit)
                        {
                            <span class="badge bg-danger">Over Budget</span>
                        }
                        else if (Model.TotalSpent > Model.BudgetLimit * 0.8m)
                        {
                            <span class="badge bg-warning">Warning</span>
                        }
                        else
                        {
                            <span class="badge bg-success">On Track</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
