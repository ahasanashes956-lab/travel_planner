@{
    ViewData["Title"] = "Create Trip";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model TripCreateViewModel

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fw-bold">
                <i class="fas fa-plus-circle me-2 text-primary"></i>Create New Trip
            </h1>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow">
                <div class="card-body p-4">
                    <form method="post" asp-action="Create">
                        <div class="row">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="Title" class="form-label fw-bold">Trip Title</label>
                                    <input type="text" class="form-control form-control-lg" id="Title" name="Trip.Title" placeholder="e.g., Summer Vacation to Paris" required>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="DestinationId" class="form-label fw-bold">Destination</label>
                                    <select class="form-select form-select-lg" id="DestinationId" name="Trip.DestinationId" required>
                                        <option value="">Select a destination...</option>
                                        @foreach (var destination in Model.Destinations)
                                        {
                                            <option value="@destination.Id">@destination.Name, @destination.Country</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="TripType" class="form-label fw-bold">Trip Type</label>
                                    <select class="form-select form-select-lg" id="TripType" name="Trip.TripType" required>
                                        <option value="">Select trip type...</option>
                                        <option value="Solo">Solo</option>
                                        <option value="Family">Family</option>
                                        <option value="Friends">Friends</option>
                                        <option value="Business">Business</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="StartDate" class="form-label fw-bold">Start Date</label>
                                    <input type="date" class="form-control form-control-lg" id="StartDate" name="Trip.StartDate" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="EndDate" class="form-label fw-bold">End Date</label>
                                    <input type="date" class="form-control form-control-lg" id="EndDate" name="Trip.EndDate" required>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="NumberOfTravelers" class="form-label fw-bold">Number of Travelers</label>
                                    <input type="number" class="form-control form-control-lg" id="NumberOfTravelers" name="Trip.NumberOfTravelers" min="1" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="BudgetLimit" class="form-label fw-bold">Budget Limit ($)</label>
                                    <input type="number" class="form-control form-control-lg" id="BudgetLimit" name="Trip.BudgetLimit" step="0.01" required>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label fw-bold">Description</label>
                            <textarea class="form-control" id="Description" name="Trip.Description" rows="4" placeholder="Tell us about your trip plans..."></textarea>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/trip" class="btn btn-outline-secondary btn-lg">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-check me-2"></i>Create Trip
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow bg-light">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">
                        <i class="fas fa-lightbulb text-warning me-2"></i>Trip Planning Tips
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Choose a clear trip title</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Set a realistic budget</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Plan with a buffer for unexpected expenses</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Add all travelers to your plan</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Research your destination first</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
