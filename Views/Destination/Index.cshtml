@model IEnumerable<Destination>
@{
    ViewData["Title"] = "Destinations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="fw-bold mb-4">
                <i class="fas fa-globe me-2 text-primary"></i>Explore Destinations
            </h1>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <form method="get" asp-action="Search" class="d-flex">
                <input type="text" class="form-control form-control-lg me-2" name="query" placeholder="Search destinations..." value="">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-search"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Destinations Grid -->
    @if (Model.Count() > 0)
    {
        <div class="row g-4">
            @foreach (var destination in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <a href="/destination/details/@destination.Id" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 hover-card">
                            <div class="position-relative">
                                <img src="@destination.ImageUrl" class="card-img-top" style="height: 250px; object-fit: cover;" alt="@destination.Name" />
                                <div class="position-absolute top-0 start-0 bg-dark bg-opacity-50 text-white p-2 m-3 rounded">
                                    <span class="badge bg-primary">@destination.Category</span>
                                </div>
                                <div class="position-absolute bottom-0 end-0 bg-warning text-dark p-2 m-3 rounded fw-bold">
                                    <i class="fas fa-star"></i> @destination.AverageRating.ToString("F1") (@destination.ReviewCount)
                                </div>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title text-dark fw-bold">@destination.Name</h5>
                                <p class="card-text text-muted">
                                    <i class="fas fa-map-marker-alt"></i> @destination.City, @destination.Country
                                </p>
                                <p class="card-text text-truncate">@destination.Description</p>
                                <small class="text-muted d-block mt-2">
                                    <i class="fas fa-calendar"></i> Best time: Month @destination.BestTimeToVisit
                                </small>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-search fa-3x mb-3 d-block text-muted"></i>
            <h5>No destinations found</h5>
            <p>Try searching with different keywords</p>
        </div>
    }
</div>
