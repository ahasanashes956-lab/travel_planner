@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="hero-section text-white py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 500px;">
    <div class="container d-flex align-items-center h-100">
        <div class="row w-100">
            <div class="col-md-6 d-flex flex-column justify-content-center">
                <h1 class="display-4 fw-bold mb-4">Plan Your Next Adventure</h1>
                <p class="fs-5 mb-4">Discover amazing destinations, plan your itinerary, manage your budget, and create unforgettable travel memories.</p>
                <div>
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a href="/account/register" class="btn btn-light btn-lg me-3">Get Started</a>
                        <a href="/account/login" class="btn btn-outline-light btn-lg">Login</a>
                    }
                    else
                    {
                        <a href="/trip/create" class="btn btn-light btn-lg me-3">Create Trip</a>
                        <a href="/destination" class="btn btn-outline-light btn-lg">Explore Destinations</a>
                    }
                </div>
            </div>
            <div class="col-md-6 text-center">
                <i class="fas fa-plane-departure fa-10x opacity-25"></i>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-5 fw-bold">Why Choose Travel Planner?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 h-100 shadow-sm hover-card">
                    <div class="card-body text-center">
                        <i class="fas fa-map-marked-alt fa-3x text-primary mb-3"></i>
                        <h5 class="card-title fw-bold">Smart Planning</h5>
                        <p class="card-text text-muted">Create detailed itineraries with day-wise schedules and activities.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 h-100 shadow-sm hover-card">
                    <div class="card-body text-center">
                        <i class="fas fa-wallet fa-3x text-success mb-3"></i>
                        <h5 class="card-title fw-bold">Budget Management</h5>
                        <p class="card-text text-muted">Track expenses and manage your travel budget efficiently.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 h-100 shadow-sm hover-card">
                    <div class="card-body text-center">
                        <i class="fas fa-star fa-3x text-warning mb-3"></i>
                        <h5 class="card-title fw-bold">Discover Places</h5>
                        <p class="card-text text-muted">Explore top destinations and read reviews from travelers.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Destinations Section -->
@if (Model != null && Model.Count() > 0)
{
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-5 fw-bold">Popular Destinations</h2>
            <div class="row g-4">
                @foreach (var destination in Model.Take(6))
                {
                    <div class="col-md-4 col-lg-3">
                        <a href="/destination/details/@destination.Id" class="text-decoration-none">
                            <div class="card border-0 shadow-sm h-100 hover-card">
                                <div class="position-relative">
                                    <img src="@destination.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@destination.Name" />
                                    <div class="position-absolute top-0 end-0 bg-danger text-white p-2 m-2 rounded">
                                        <i class="fas fa-star"></i> @destination.AverageRating.ToString("F1")
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title text-dark">@destination.Name</h5>
                                    <p class="card-text text-muted small">@destination.Country</p>
                                    <span class="badge bg-primary">@destination.Category</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Call to Action Section -->
<section class="py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Ready to Start Your Journey?</h2>
        <p class="fs-5 mb-4">Join thousands of travelers planning their dream trips with Travel Planner.</p>
        <a href="/account/register" class="btn btn-light btn-lg">Create Free Account</a>
    </div>
</section>

@section Scripts {
    <script>
        // Add smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
}
