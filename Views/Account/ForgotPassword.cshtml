@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4 fw-bold">
                        <i class="fas fa-redo text-primary me-2"></i>Reset Password
                    </h2>

                    <p class="text-muted text-center mb-4">
                        Enter your email address and we'll send you a link to reset your password.
                    </p>

                    <form method="post">
                        <div class="mb-3">
                            <label for="Email" class="form-label">Email Address</label>
                            <input type="email" class="form-control form-control-lg" id="Email" name="Email" required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg fw-bold mb-3">Send Reset Link</button>
                    </form>

                    <hr>
                    <p class="text-center text-muted">
                        Remember your password? <a href="/account/login" class="text-primary fw-bold">Login</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
